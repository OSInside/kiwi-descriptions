<?xml version="1.0" encoding="utf-8"?>

<image schemaversion="7.6" name="Leap-16.0_vagrant">
    <description type="system">
        <author>Marcus Schaefer</author>
        <contact>ms@suse.de</contact>
        <specification>
            Leap 16.0 box system for vagrant
        </specification>
    </description>
    <profiles>
        <profile name="libvirt" description="Vagrant Box for Libvirt"/>
        <profile name="virtualbox" description="Vagrant Box for VirtualBox"/>
    </profiles>
    <preferences>
        <version>1.16.0</version>
        <packagemanager>zypper</packagemanager>
        <locale>en_US</locale>
        <keytable>us</keytable>
        <timezone>UTC</timezone>
        <rpm-excludedocs>true</rpm-excludedocs>
        <rpm-check-signatures>false</rpm-check-signatures>
    </preferences>
    <preferences profiles="libvirt">
        <type image="oem" filesystem="ext4" format="vagrant" firmware="efi" kernelcmdline="net.ifnames=0 console=ttyS0">
            <bootloader name="grub2" timeout="0" console="serial"/>
            <vagrantconfig provider="libvirt" virtualsize="42" boxname="opensuse/leap160"/>
            <size unit="G">42</size>
            <oemconfig>
                <oem-resize>false</oem-resize>
            </oemconfig>
        </type>
    </preferences>
    <preferences profiles="virtualbox">
        <type image="oem" filesystem="ext4" format="vagrant" kernelcmdline="net.ifnames=0 console=ttyS0">
            <bootloader name="grub2" timeout="0" console="serial"/>
            <vagrantconfig provider="virtualbox" virtualbox_guest_additions_present="true" virtualsize="42" boxname="opensuse/leap160"/>
            <size unit="G">42</size>
            <oemconfig>
                <oem-resize>false</oem-resize>
            </oemconfig>
        </type>
    </preferences>
    <users>
        <user password="$6$kiwiVagrant$DS45ytDgSMSZAIgL45CzZBKQ8/Q4emHRp2Q94SkXvkQD7h3UjRcnaQJu.LZc3VwfodF/K2bvg2O.z.mvB8ZFt1" home="/root" name="root" groups="root"/>
        <user password="$6$kiwiVagrant$DS45ytDgSMSZAIgL45CzZBKQ8/Q4emHRp2Q94SkXvkQD7h3UjRcnaQJu.LZc3VwfodF/K2bvg2O.z.mvB8ZFt1" home="/home/vagrant" name="vagrant" groups="vagrant"/>
    </users>
    <repository type="rpm-md" alias="Leap_16.0" imageinclude="true">
        <source path="https://download.opensuse.org/distribution/leap/16.0/repo/oss"/>
    </repository>
    <packages type="image">
        <package name="grub2"/>
        <package name="grub2-x86_64-efi" arch="x86_64"/>
        <package name="grub2-i386-pc"/>
        <package name="shim"/>
        <package name="kernel-default"/>
        <package name="iputils"/>
        <package name="iproute2"/>
        <package name="vim"/>
        <package name="tar"/>
        <package name="less"/>
        <package name="bash-completion"/>
        <package name="which"/>
        <package name="timezone"/>
        <package name="openssh"/>
        <package name="sudo"/>
        <package name="rsync"/>
        <package name="NetworkManager"/>
        <package name="procps"/>
    </packages>
    <packages type="image" profiles="virtualbox">
        <package name="virtualbox-guest-tools"/>
    </packages>
    <packages type="bootstrap">
        <package name="udev"/>
        <package name="filesystem"/>
        <package name="glibc-locale"/>
        <package name="cracklib-dict-full"/>
        <package name="ca-certificates"/>
        <package name="ca-certificates-mozilla"/>
        <package name="Leap-release"/>
    </packages>
</image>
