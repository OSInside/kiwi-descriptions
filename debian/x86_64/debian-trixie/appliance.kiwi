<?xml version="1.0" encoding="utf-8"?>

<image schemaversion="7.6" name="Debian-Trixie_appliance">
    <description type="system">
        <author>Marcus Schäfer</author>
        <contact>marcus.schaefer@gmail.com</contact>
        <specification>Debian 13 (Trixie) Appliance</specification>
    </description>
    <profiles>
        <profile name="Live" description="Live image"/>
        <profile name="Virtual" description="Simple Disk image"/>
        <profile name="Disk" description="Expandable Disk image"/>
    </profiles>
    <preferences>
        <version>13.1.0</version>
        <packagemanager>apt</packagemanager>
        <bootsplash-theme>fade-in</bootsplash-theme>
        <bootloader-theme>starfield</bootloader-theme>
        <locale>en_US</locale>
        <timezone>Europe/Berlin</timezone>
        <rpm-check-signatures>false</rpm-check-signatures>
    </preferences>
    <preferences profiles="Live">
        <type image="iso" flags="overlay" hybridpersistent_filesystem="ext4" hybridpersistent="true" firmware="efi">
            <bootloader name="grub2" timeout="10"/>
        </type>
    </preferences>
    <preferences profiles="Virtual">
        <type image="oem" filesystem="ext4" kernelcmdline="console=ttyS0 console=tty0" firmware="uefi" format="qcow2">
            <bootloader name="grub2" timeout="10"/>
            <oemconfig>
                <oem-resize>false</oem-resize>
            </oemconfig>
        </type>
    </preferences>
    <preferences profiles="Disk">
        <type image="oem" filesystem="ext4" firmware="efi" installiso="true">
            <bootloader name="grub2" timeout="10"/>
            <oemconfig>
                <oem-swap>true</oem-swap>
                <oem-device-filter>/dev/ram</oem-device-filter>
                <oem-multipath-scan>false</oem-multipath-scan>
            </oemconfig>
        </type>
    </preferences>
    <users>
        <user password="$6$kiwiDescr$Pk4z8v/uAP/UM8zWcddBBXWcqTx8T9jYU30fXC6fLXguQ8Kp.quDokrGuzXF3JzzkYX75YKJYdiF75aCZOOEP1" home="/root" name="root" groups="root"/>
    </users>
    <repository type="apt-deb" alias="kiwi" repository_gpgcheck="false">
        <source path="obs://Virtualization:Appliances:Builder/Debian_13"/>
    </repository>
    <repository type="apt-deb" alias="Trixie-security" distribution="trixie-security" components="main contrib non-free non-free-firmware" repository_gpgcheck="false">
        <source path="http://security.debian.org/debian-security"/>
    </repository>
    <repository type="apt-deb" alias="Trixie-updates" distribution="trixie-updates" components="main contrib non-free non-free-firmware" repository_gpgcheck="false">
        <source path="http://deb.debian.org/debian"/>
    </repository>
    <repository type="apt-deb" alias="Trixie" distribution="trixie" components="main contrib non-free non-free-firmware" repository_gpgcheck="false">
        <source path="http://deb.debian.org/debian"/>
    </repository>
    <packages type="image">
        <package name="libpam-runtime"/>
        <package name="grub-theme-starfield"/>
        <package name="plymouth-themes"/>
        <package name="vim"/>
        <package name="plymouth"/>
        <package name="grub-pc-bin"/>
        <package name="grub2-common"/>
        <package name="grub-efi-amd64-bin"/>
        <package name="dracut"/>
        <package name="xz-utils"/>
        <package name="binutils"/>
        <package name="linux-image-amd64"/>
        <package name="init"/>
        <package name="gnupg"/>
        <package name="iproute2"/>
        <package name="iptables"/>
        <package name="iputils-ping"/>
        <package name="ifupdown"/>
        <package name="isc-dhcp-client"/>
        <package name="netbase"/>
        <package name="bsdmainutils"/>
        <package name="net-tools"/>
        <package name="dbus"/>
        <package name="locales-all"/>
        <package name="tzdata"/>
        <package name="openssh-server"/>
        <package name="fdisk"/>
        <package name="dialog"/>
        <package name="login"/>
    </packages>
    <packages type="image" profiles="Virtual">
        <package name="shim-signed"/>
        <package name="grub-efi-amd64-signed"/>
    </packages>
    <packages type="iso">
        <package name="dracut-kiwi-live"/>
    </packages>
    <packages type="oem">
        <package name="dracut-kiwi-oem-repart"/>
        <package name="dracut-kiwi-oem-dump"/>
    </packages>
    <packages type="bootstrap">
        <package name="ca-certificates"/>
    </packages>
</image>
