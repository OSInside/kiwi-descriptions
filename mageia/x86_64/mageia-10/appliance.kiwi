<?xml version="1.0" encoding="utf-8"?>

<image schemaversion="7.6" name="Mageia-10_appliance">
    <description type="system">
        <author>Marcus Schäfer</author>
        <contact>marcus.schaefer@gmail.com</contact>
        <specification>Mageia 10 Appliance</specification>
    </description>
    <!--
        Mageia does not provide the kiwi dracut modules, thus only
        a simple disk image which does not resize itself on first
        boot can be built
    -->
    <preferences>
        <version>10.0.0</version>
        <packagemanager>dnf5</packagemanager>
        <bootsplash-theme>charge</bootsplash-theme>
        <locale>en_US</locale>
        <keytable>us</keytable>
        <timezone>UTC</timezone>
        <rpm-check-signatures>false</rpm-check-signatures>
        <type image="oem" filesystem="ext4" firmware="efi" kernelcmdline="console=tty0 console=ttyS0" format="qcow2">
            <bootloader name="grub2" timeout="10"/>
            <oemconfig>
                <oem-resize>false</oem-resize>
            </oemconfig>
        </type>
    </preferences>
    <users>
        <user password="$6$kiwiDescr$Pk4z8v/uAP/UM8zWcddBBXWcqTx8T9jYU30fXC6fLXguQ8Kp.quDokrGuzXF3JzzkYX75YKJYdiF75aCZOOEP1" home="/root" name="root" groups="root"/>
    </users>
    <repository type="rpm-md" alias="Mageia10-core-updates">
        <source path="https://mirrors.kernel.org/mageia/distrib/10/x86_64/media/core/updates/"/>
    </repository>
    <repository type="rpm-md" alias="Mageia10-core">
        <source path="https://mirrors.kernel.org/mageia/distrib/10/x86_64/media/core/release/"/>
    </repository>
    <packages type="image">
        <package name="kernel-server-latest"/>
        <package name="dracut"/>
        <package name="grub2"/>
        <package name="grub2-efi"/>
        <package name="grub2-mageia-theme"/>
        <package name="plymouth-theme-charge"/>
        <package name="locales-en"/>
        <package name="rootfiles"/>
        <package name="kbd"/>
        <package name="networkmanager"/>
        <package name="openssh-server"/>
        <package name="chrony"/>
        <package name="sudo"/>
        <package name="vim-enhanced"/>
        <package name="e2fsprogs"/>
        <package name="dnf5"/>
        <ignore name="perl-URPM"/>
        <ignore name="urpmi"/>
    </packages>
    <packages type="bootstrap">
        <package name="filesystem"/>
        <package name="basesystem-minimal"/>
        <package name="mageia-release-Default"/>
        <ignore name="perl-URPM"/>
        <ignore name="urpmi"/>
    </packages>
</image>
